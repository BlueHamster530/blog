---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title: string;
  description?: string;
  sidebar?: boolean;
  activeGroup?: string;
  activeSub?: string;
}
const {
  title,
  description = '',
  sidebar = true,
  activeGroup = '',
  activeSub = '',
} = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <link rel="icon" href={`${base}favicon.svg`} />
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={base}>BlueHamster</a>
        <nav>
          <a href={base}>글 목록</a>
          <a href={`${base}search`}>검색</a>
        </nav>
      </div>
    </header>
    <div class={`wrap page-grid ${sidebar ? '' : 'no-side'}`}>
      <main class="content">
        <slot />
      </main>
      {sidebar && <Sidebar activeGroup={activeGroup} activeSub={activeSub} />}
    </div>
    <footer class="site">
      <div class="wrap">© BlueHamster · Astro + GitHub Pages로 자동 발행</div>
    </footer>
  </body>
</html>
