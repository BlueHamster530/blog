---
import { url, type CatInfo } from '../lib/posts';

interface Props {
  categories: CatInfo[];
  active?: string; // 활성 카테고리 슬러그 ('' = 전체)
  total: number;
}
const { categories, active = '', total } = Astro.props;
---
<div class="toolbar">
  <form class="search-box" action={url('search')} method="get" role="search">
    <input type="search" name="q" placeholder="글 검색…" aria-label="글 검색" />
    <button type="submit" aria-label="검색">🔍</button>
  </form>
  <nav class="cat-bar" aria-label="카테고리">
    <a class={`chip ${active === '' ? 'on' : ''}`} href={url()}>전체 <span>{total}</span></a>
    {categories.map((c) => (
      <a class={`chip ${active === c.slug ? 'on' : ''}`} href={url(`category/${c.slug}`)}>
        {c.name} <span>{c.count}</span>
      </a>
    ))}
  </nav>
</div>
