---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Toolbar from '../../components/Toolbar.astro';
import { getSortedPosts, categoryList, catSlug } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  const cats = categoryList(posts);
  return cats.map((c) => ({
    params: { cat: c.slug },
    props: {
      name: c.name,
      slug: c.slug,
      posts: posts.filter((p) => catSlug(p.data.category || '기타') === c.slug),
    },
  }));
}

const { name, slug, posts } = Astro.props;
const allPosts = await getSortedPosts();
const cats = categoryList(allPosts);
---
<BaseLayout title={`${name} · BlueHamster 블로그`} description={`${name} 카테고리 글 목록`}>
  <section class="intro">
    <h1>{name}</h1>
    <p><span class="count">{posts.length}개</span>의 글</p>
  </section>
  <Toolbar categories={cats} active={slug} total={allPosts.length} />
  <ul class="post-list">
    {posts.map((post) => <PostCard post={post} />)}
  </ul>
</BaseLayout>
