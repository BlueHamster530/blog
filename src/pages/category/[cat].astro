---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getSortedPosts, categoryList, catSlug, groupOf, url } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  const cats = categoryList(posts);
  return cats.map((c) => ({
    params: { cat: c.slug },
    props: {
      name: c.name,
      slug: c.slug,
      posts: posts.filter((p) => catSlug(groupOf(p.data.category)) === c.slug),
    },
  }));
}

const { name, slug, posts } = Astro.props;
---
<BaseLayout title={`${name} · BlueHamster 블로그`} description={`${name} 카테고리 글 목록`} activeGroup={slug}>
  <nav class="crumb">
    <a href={url()}>전체</a>
    <span>›</span>
    <strong>{name}</strong>
  </nav>
  <section class="intro">
    <h1>{name}</h1>
    <p><span class="count">{posts.length}개</span>의 글</p>
  </section>
  <ul class="post-list">
    {posts.map((post) => <PostCard post={post} />)}
  </ul>
</BaseLayout>
